# Video Discusser configuration.
# Copy to `.env` and adjust. Never commit `.env`.
# Every value here is a starting point to be validated against the
# model/runtime benchmark (Sprint 1/11) — not a proven safe limit.

APP_ENV=development

# Backend binds to loopback only. Never use 0.0.0.0.
APP_HOST=127.0.0.1
APP_PORT=8000

# Local VLM runtime. MUST differ from APP_PORT.
# Sprint 1 decision: Ollama (llama.cpp/Vulkan) — see docs/runtime-feasibility.md.
# Standalone llama-server on 8081 remains a documented fallback via the adapter.
INFERENCE_BASE_URL=http://127.0.0.1:11434
INFERENCE_MODEL=qwen3.5:4b

# Context window requested per generation (12 frames ≈ 4k vision tokens).
INFERENCE_NUM_CTX=8192

# Frame & window budgets (server clamps request-level values to these caps)
ANALYSIS_WINDOW_SECONDS=180
MAX_FRAMES_PER_REQUEST=12
MAX_FRAME_DIMENSION=768
JPEG_QUALITY=80

# Timeouts and concurrency
MAX_CONCURRENT_INFERENCE=1
INFERENCE_TIMEOUT_SECONDS=180
EXTRACTION_TIMEOUT_SECONDS=120

# Input bounds
MAX_QUESTION_CHARS=2000
MAX_CHAT_TURNS=8

# Cache
CACHE_DIR=./data/cache

# Local-file mode: semicolon-separated allowlist of directories the app may
# read videos from. Browser requests may only reference files inside these
# roots; the roots come from trusted local configuration. Empty = disabled.
# Example: LOCAL_MEDIA_DIRS=C:\Users\me\Videos;D:\Clips
LOCAL_MEDIA_DIRS=

# Optional YouTube source via yt-dlp (pip install yt-dlp). Opt-in; downloading
# must comply with YouTube's terms, copyright, and applicable law. No DRM
# circumvention is attempted or supported.
YOUTUBE_SOURCE_ENABLED=false

# Download timeout for the YouTube source.
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=600
